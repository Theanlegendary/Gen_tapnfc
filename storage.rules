rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && firestore.exists(userPath());
    }

    function role() {
      return userExists() ? firestore.get(userPath()).data.role : 'guest';
    }

    function isSalesOrAdmin() {
      return role() in ['sales', 'sales_rep', 'admin', 'super_admin'];
    }

    match /order-artwork/{salesUserId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isSalesOrAdmin()
        && request.auth.uid == salesUserId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn()
        && isSalesOrAdmin()
        && request.auth.uid == salesUserId;
    }
  }
}
